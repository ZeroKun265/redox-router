# Maintainer: ZeroKun265 <davidegiambirtone265@gmail.com>
pkgname=redox-router-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="A node-based PipeWire patchbay (qpwgraph alternative) with clean ownership and smart routing (precompiled binary)"
arch=('x86_64')
url="https://github.com/ZeroKun265/redox-router"
license=('MIT')
depends=('pipewire' 'gcc-libs' 'glibc')
provides=('redox-router')
conflicts=('redox-router' 'redox-router-git')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/ZeroKun265/redox-router/releases/download/v${pkgver}/redox-router-x86_64-linux.tar.gz")
sha256sums=('SKIP')

package() {
    install -Dm755 "${srcdir}/redox-router" "${pkgdir}/usr/bin/redox-router"
    install -Dm644 "${srcdir}/extra/redox-router.desktop" "${pkgdir}/usr/share/applications/redox-router.desktop"
    install -Dm644 "${srcdir}/extra/redox-router.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/redox-router.svg"
    install -Dm644 "${srcdir}/extra/redox-router.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/redox-router.png"
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
